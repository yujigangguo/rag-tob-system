# 复制本文件为 .env 后填入真实值(注意:.env 不要提交到 git)

# ===== 应用与认证 =====
SECRET_KEY=please-change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== MySQL 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rag_user
DB_PASSWORD=rag_pass123
DB_NAME=rag_db

# ===== 大模型 (通义千问 qwen-max) =====
# 填通义 DashScope API Key(与 Embedding 可用同一个)
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_MAX_TOKENS=2048

# ===== Embedding (通义) =====
EMBEDDING_API_KEY=sk-xxxxxxxx
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ===== Rerank (可选) =====
RERANK_API_KEY=
RERANK_MODEL=gte-rerank

# ===== 历史对话 =====
DEFAULT_HISTORY_ROUNDS=5

# ===== 向量库 Milvus =====
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
# Milvus 数据卷目录(Docker Compose 用;指向本机已有 Milvus 数据目录)
MILVUS_VOLUME_DIR=./volumes

# ===== 检索 =====
RETRIEVAL_TOP_K=20
FINAL_TOP_K=5

# ===== 上传限制 =====
# 单文件上传上限(MB);需与前端 nginx 的 client_max_body_size 保持一致
MAX_UPLOAD_SIZE_MB=10
